{
  "name": "@blacklite/crew",
  "version": "0.11.0-build.6",
  "private": true,
  "description": "Crew — Programmable multi-agent runtime for GitHub Copilot and Claude Code",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@blacklite/crew-sdk": "file:packages/crew-sdk"
  },
  "overrides": {
    "@blacklite/crew-cli": {
      "@blacklite/crew-sdk": "$@blacklite/crew-sdk"
    }
  },
  "scripts": {
    "prebuild": "node scripts/bump-build.mjs && node scripts/sync-skill-templates.mjs && node scripts/sync-templates.mjs",
    "build": "npm run build -w packages/crew-sdk && npm run build -w packages/crew-cli",
    "sync-templates": "node scripts/sync-templates.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/run-benchmarks.mjs",
    "experiment:memory-value": "node scripts/measure-memory-value.mjs",
    "experiment:real-cli-ab": "node scripts/real-cli-ab.js",
    "bench:cold-start": "node scripts/measure-cold-start.mjs",
    "lint": "tsc --noEmit -p packages/crew-sdk/tsconfig.json && tsc --noEmit -p packages/crew-cli/tsconfig.json",
    "lint:eslint": "eslint packages/ test/",
    "lint:docs": "markdownlint-cli2 && cspell --no-progress --dot \"docs/src/content/**/*.md\" \"README.md\"",
    "dev:link": "npm run build && cd packages/crew-sdk && npm link && cd ../crew-cli && npm link",
    "dev:unlink": "cd packages/crew-cli && npm unlink && cd ../crew-sdk && npm unlink",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "docs:build": "npm run docs:api && cd docs && npm run build",
    "docs:dev": "cd docs && npm run dev",
    "docs:preview": "cd docs && npm run preview"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@playwright/test": "^1.62.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.2",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "copilot",
    "multi-agent",
    "crew",
    "sdk"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Blacklite/crew#readme",
  "bugs": {
    "url": "https://github.com/Blacklite/crew/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Blacklite/crew.git"
  }
}
